<?xml version="1.0" encoding="utf-8"?>
<!-- Medium/expanded width: single row of four status tiles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

        <include android:id="@+id/stat_vacant" layout="@layout/view_stat_card" />
        <include android:id="@+id/stat_today" layout="@layout/view_stat_card" />
        <include android:id="@+id/stat_requests" layout="@layout/view_stat_card" />
        <include android:id="@+id/stat_cancellations" layout="@layout/view_stat_card" />
</LinearLayout>
