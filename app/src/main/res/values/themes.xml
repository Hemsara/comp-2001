<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RoomHub" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/rh_primary</item>
        <item name="colorOnPrimary">@color/rh_on_primary</item>
        <item name="colorPrimaryContainer">@color/rh_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/rh_on_primary_container</item>
        <item name="colorSecondary">@color/rh_secondary</item>
        <item name="colorOnSecondary">@color/rh_on_secondary</item>
        <item name="colorSecondaryContainer">@color/rh_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/rh_on_secondary_container</item>
        <item name="colorError">@color/rh_error</item>
        <item name="colorOnError">@color/rh_on_error</item>
        <item name="colorErrorContainer">@color/rh_error_container</item>
        <item name="colorOnErrorContainer">@color/rh_on_error_container</item>
        <item name="android:colorBackground">@color/rh_background</item>
        <item name="colorSurface">@color/rh_surface</item>
        <item name="colorOnSurface">@color/rh_on_surface</item>
        <item name="colorSurfaceVariant">@color/rh_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/rh_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/rh_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/rh_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/rh_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/rh_surface_container_high</item>
        <item name="colorOutline">@color/rh_outline</item>
        <item name="colorOutlineVariant">@color/rh_outline_variant</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.RoomHub.Medium</item>
        <item name="materialCardViewStyle">@style/Widget.RoomHub.Card</item>
        <item name="textInputStyle">@style/Widget.RoomHub.TextInput</item>
        <item name="chipStyle">@style/Widget.Material3.Chip.Filter</item>
    </style>

    <style name="Theme.RoomHub.Login" parent="Theme.RoomHub" />

    <style name="ShapeAppearance.RoomHub.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="Widget.RoomHub.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="cardElevation">1dp</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="Widget.RoomHub.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
    </style>

    <style name="Widget.RoomHub.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Widget.RoomHub.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Widget.RoomHub.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.RoomHub.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.RoomHub.Button.Destructive" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorError</item>
        <item name="iconTint">?attr/colorError</item>
        <item name="strokeColor">?attr/colorError</item>
    </style>

    <!-- Typography scale -->
    <style name="TextAppearance.RoomHub.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.RoomHub.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.RoomHub.SectionLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="TextAppearance.RoomHub.StatValue" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.RoomHub.StatusPill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_status_pill</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelMedium</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
